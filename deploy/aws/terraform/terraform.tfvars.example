# AWS region.
region = "us-east-2"

# Existing public Route 53 zone.
zone_name = "agenticml.xyz"

# Hosted service DNS name.
hostname = "app.agenticml.xyz"

# Canonical HTTPS origin; match hostname.
public_url = "https://app.agenticml.xyz"

# Dedicated /16 VPC; proxy trust is limited to its private subnets.
vpc_cidr = "10.42.0.0/16"

# Firebase project ID.
firebase_project = "REPLACE_ME"

# Public Firebase web API key; not a secret.
firebase_api_key = "REPLACE_ME"

# Enable only after owner verifies Firebase and free limits.
open_signup = false

# Enable RDS Multi-AZ when required.
multi_az = false

# Globally unique private objects bucket name.
objects_bucket_name = "REPLACE_ME"

# Globally unique ALB log bucket name.
logs_bucket_name = "REPLACE_ME"

# SNS alarm email; owner must confirm subscription.
alarm_email = "REPLACE_ME"

# Existing GitHub OIDC provider ARN, or null to create it.
github_oidc_provider_arn = null

# Initial private ECR image tag; push before starting service.
image_tag = "bootstrap"

# Use 0 for initial apply before first image push, then 2.
desired_count = 2

# Unique RDS final snapshot name; change before each destruction.
final_snapshot_identifier = "REPLACE_ME"

