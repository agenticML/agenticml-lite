# /etc/agenticml-server.env: install as root, owner root, mode 0600.
#   sudo install -m 0600 -o root -g root agenticml-server.env.example /etc/agenticml-server.env
# The server unit reads it (EnvironmentFile) and it overrides the unit's
# placeholder URL.

# The URL that browsers and training machines use, as seen on the proxy.
# Include the port if it is not 443, for example https://agenticml.lab.internal:8443
AGENTICML_SERVER_PUBLIC_URL=https://agenticml.lab.internal

# The proxy's exact address as /32 (or /128 for IPv6), never a subnet. Every
# address in this range can set the client address and identity headers.
# 127.0.0.1/32 is right when the proxy runs on the same machine.
AGENTICML_SERVER_TRUSTED_PROXIES=127.0.0.1/32

# Do not set AGENTICML_SERVER_KEY here: a key from the environment turns off
# the first-admin /setup link. Create the first admin from the journal link
# (README.md, step 6).
#
# No identity header is set. Sign-in uses passwords and invites. For single
# sign-on through oauth2-proxy, see the variant at the end of README.md.
